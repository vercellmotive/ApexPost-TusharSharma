<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests against real infrastructure, all in process: SQLite in memory, Couchbase Lite in a temporary folder and the
    API and MVC apps through WebApplicationFactory. The SQL Server tests run only when APEXPOST_TEST_SQLSERVER is set.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Testing\ApexPost.Testing.csproj" />
    <ProjectReference Include="..\ApexPost.Web\ApexPost.Web.csproj" Aliases="global,web" />
    <ProjectReference Include="..\ApexPost.Api\ApexPost.Api.csproj" Aliases="global,api" />
    <ProjectReference Include="..\ApexPost.Client.Consumer\ApexPost.Client.Consumer.csproj" />
    <ProjectReference Include="..\ApexPost.Courier.Offline.Harness\ApexPost.Courier.Offline.Harness.csproj" />
    <ProjectReference Include="..\ApexPost.Infrastructure\ApexPost.Infrastructure.csproj" />
    <ProjectReference Include="..\ApexPost.Tracking.Infrastructure\ApexPost.Tracking.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
