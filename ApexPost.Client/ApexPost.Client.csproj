<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A typed C# client for ApexPost API v2, generated by NSwag from contracts/v2.json. Regenerate it after the
    contract changes, from the repository root:
      dotnet tool restore
      dotnet nswag run ApexPost.Client/nswag.json
    Never edit Generated/ by hand. Additions go in the partial classes and wrappers beside it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
