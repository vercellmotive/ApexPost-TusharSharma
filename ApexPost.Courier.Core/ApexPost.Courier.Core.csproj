<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything in the courier app that is not a screen or a device service: the typed API client, its handlers and
    resilience pipeline, JSON, sync and the view models. It is plain net10.0, so it builds and is tested without the
    MAUI workload. ApexPost.Courier (the MAUI app) supplies SecureStorage, Connectivity and the pages.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Courier.Offline\ApexPost.Courier.Offline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApexPost.Courier.Core.Tests" />
  </ItemGroup>

</Project>
