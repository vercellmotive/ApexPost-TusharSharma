{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tracking": {
    "PrepareDevelopmentDatabase": false
  },
  "Jwt": {
    "Issuer": "https://identity.apexpost.example/dev",
    "Audience": "apexpost-api",
    "SigningKey": "",
    "DevelopmentTokenMinutes": 60
  },
  "PartnerApiKeys": {
    "Keys": {}
  },
  "RateLimiting": {
    "GeneralPerMinute": 600,
    "PartnerPerMinute": 30
  }
}
