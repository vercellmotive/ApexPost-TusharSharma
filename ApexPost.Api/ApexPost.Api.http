Authorization: Bearer {{staff.response.body.$.accessToken}}

# ===================================================================================================
# Part B URLs without a version keep working: they are served as v1 and carry the deprecation headers.
# ===================================================================================================

### Unversioned (served as v1): 200
GET {{baseUrl}}/api/shipments/APX-10000001
Authorization: Bearer {{staff.response.body.$.accessToken}}

### Unknown version: 404
GET {{baseUrl}}/api/v3/shipments/APX-10000001
Authorization: Bearer {{staff.response.body.$.accessToken}}

# ===================================================================================================
# Security: 401, 403, the courierId rule and the partner API key (D2, D3).
# ===================================================================================================

### No token: 401 ProblemDetails with a Bearer challenge
GET {{baseUrl}}/api/v2/shipments/APX-10000001

### Invalid token: 401 "The access token is not valid."
GET {{baseUrl}}/api/v2/shipments/APX-10000001
Authorization: Bearer not-a-real-token

### Valid courier token, any signed-in user may read: 200
GET {{baseUrl}}/api/v2/shipments/APX-10000001
Authorization: Bearer {{courier.response.body.$.accessToken}}

### Courier deleting a shipment: 403, DELETE is Admin only
DELETE {{baseUrl}}/api/v2/shipments/APX-10000001
Authorization: Bearer {{courier.response.body.$.accessToken}}

### Admin uploading scans: 403, scan upload is Courier only
POST {{baseUrl}}/api/v2/shipments/APX-10000001/scans
Authorization: Bearer {{admin.response.body.$.accessToken}}
Content-Type: application/json

{ "scans": [ { "scanId": "scan::3f2504e0-4f89-41d3-9a0c-0305e82c3501", "scanType": "Pickup", "courierId": "CR-1001", "location": "Depot", "scannedAtUtc": "{{$datetime iso8601}}" } ] }

### Admin changing status: 403, status PATCH is Courier only
PATCH {{baseUrl}}/api/v2/shipments/APX-10000001/status
Authorization: Bearer {{admin.response.body.$.accessToken}}
Content-Type: application/json

{ "status": "PickedUp" }

### Courier CR-1001 uploading a scan recorded by CR-2002: 403
POST {{baseUrl}}/api/v2/shipments/APX-10000001/scans
Authorization: Bearer {{courier.response.body.$.accessToken}}
Content-Type: application/json

{ "scans": [ { "scanId": "scan::3f2504e0-4f89-41d3-9a0c-0305e82c3502", "scanType": "Pickup", "courierId": "CR-2002", "location": "Depot", "scannedAtUtc": "{{$datetime iso8601}}" } ] }

### Courier CR-1001 uploading their own scan: 200
POST {{baseUrl}}/api/v2/shipments/APX-10000001/scans
Authorization: Bearer {{courier.response.body.$.accessToken}}
Content-Type: application/json

{ "scans": [ { "scanId": "scan::3f2504e0-4f89-41d3-9a0c-0305e82c3503", "scanType": "Pickup", "courierId": "CR-1001", "location": "Depot", "scannedAtUtc": "{{$datetime iso8601}}" } ] }

### Partner route with a valid API key: 200, no recipient details
GET {{baseUrl}}/api/v2/partner/shipments/APX-10000001
X-Api-Key: {{partnerKey}}

### Partner route with an invalid API key: 401
GET {{baseUrl}}/api/v2/partner/shipments/APX-10000001
X-Api-Key: not-a-valid-partner-key-0123456789abcdef

### Partner route with no API key: 401
GET {{baseUrl}}/api/v2/partner/shipments/APX-10000001

### Partner route with a bearer token instead of a key: 401, partners use keys
GET {{baseUrl}}/api/v2/partner/shipments/APX-10000001
Authorization: Bearer {{staff.response.body.$.accessToken}}
