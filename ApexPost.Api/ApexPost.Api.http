# Requests for ApexPost.Api. Run the API with the https profile first:
#   dotnet run --project ApexPost.Api --launch-profile https
# In Development the API adds fictional shipments APX-10000001 to APX-10000012.
# Every endpoint has a success request and a failure request, for v1 (deprecated) and for v2.
# Run each section top to bottom: some requests use the shipment the section's first POST creates.

@baseUrl = https://localhost:7180

# ===================================================================================================
# Version 1 (deprecated): the Part B contract. Responses carry Deprecation and Sunset headers.
# ===================================================================================================

### v1 list shipments: 200, status as a number in v1
GET {{baseUrl}}/api/v1/shipments?page=1&pageSize=5&status=InTransit&city=sydney

### v1 list shipments: 400, pageSize above the maximum of 50
GET {{baseUrl}}/api/v1/shipments?pageSize=51

### v1 create a shipment: 201 with a Location header
POST {{baseUrl}}/api/v1/shipments
Content-Type: application/json

{
  "trackingNumber": "APX-20000001",
  "originBranchCode": "B001",
  "recipientName": "Mia Fictional",
  "recipientPhone": "+61 2 5550 1234",
  "recipientAddress": "12 Example Lane",
  "city": "Sydney",
  "weightKg": 2.5
}

### v1 create a shipment: 409, the tracking number already exists (run after the request above)
POST {{baseUrl}}/api/v1/shipments
Content-Type: application/json

{
  "trackingNumber": "APX-20000001",
  "originBranchCode": "B001",
  "recipientName": "Mia Fictional",
  "recipientPhone": "+61 2 5550 1234",
  "recipientAddress": "12 Example Lane",
  "city": "Sydney",
  "weightKg": 2.5
}

### v1 create a shipment: 400 ValidationProblemDetails (bad tracking number, phone and weight; no name)
POST {{baseUrl}}/api/v1/shipments
Content-Type: application/json

{
  "trackingNumber": "APX-123",
  "originBranchCode": "B001",
  "recipientPhone": "call me",
  "recipientAddress": "12 Example Lane",
  "city": "Sydney",
  "weightKg": 70.5
}

### v1 create a shipment: 400, the Week 3 branch does not exist
POST {{baseUrl}}/api/v1/shipments
Content-Type: application/json

{
  "trackingNumber": "APX-20000009",
  "originBranchCode": "B999",
  "recipientName": "Mia Fictional",
  "recipientPhone": "+61 2 5550 1234",
  "recipientAddress": "12 Example Lane",
  "city": "Sydney",
  "weightKg": 2.5
}

### v1 create a shipment: 415, wrong content type
POST {{baseUrl}}/api/v1/shipments
Content-Type: text/plain

trackingNumber=APX-20000001

### v1 get a shipment: 200
GET {{baseUrl}}/api/v1/shipments/APX-20000001

### v1 get a shipment: 404, unknown tracking number
GET {{baseUrl}}/api/v1/shipments/APX-99999999

### v1 replace details: 200
PUT {{baseUrl}}/api/v1/shipments/APX-20000001
Content-Type: application/json

{
  "recipientName": "Noah Sample",
  "recipientPhone": "02 5550 9876",
  "recipientAddress": "3 Fictional Way",
  "city": "Perth",
  "weightKg": 4
}

### v1 replace details: 400, weight is required
PUT {{baseUrl}}/api/v1/shipments/APX-20000001
Content-Type: application/json

{
  "recipientName": "Noah Sample",
  "recipientPhone": "02 5550 9876",
  "recipientAddress": "3 Fictional Way",
  "city": "Perth"
}

### v1 change status: 200, Created to PickedUp
PATCH {{baseUrl}}/api/v1/shipments/APX-20000001/status
Content-Type: application/json

{ "status": "PickedUp" }

### v1 change status: 409, PickedUp cannot jump to Delivered
PATCH {{baseUrl}}/api/v1/shipments/APX-20000001/status
Content-Type: application/json

{ "status": "Delivered" }

### v1 upload offline scans: 200 with accepted, duplicatesSkipped and rejected
POST {{baseUrl}}/api/v1/shipments/APX-20000001/scans
Content-Type: application/json

{
  "scans": [
    { "scanId": "scan::3f2504e0-4f89-41d3-9a0c-0305e82c3301", "scanType": "Pickup", "courierId": "CR-1001", "location": "Sydney depot", "scannedAtUtc": "{{$datetime iso8601}}", "notes": "Fictional pickup" },
    { "scanId": "scan::3f2504e0-4f89-41d3-9a0c-0305e82c3302", "scanType": "InTransit", "courierId": "CR-1001", "location": "Sydney hub", "scannedAtUtc": "{{$datetime iso8601}}" }
  ]
}

### v1 upload the same scans again: 200, both counted in duplicatesSkipped
POST {{baseUrl}}/api/v1/shipments/APX-20000001/scans
Content-Type: application/json

{
  "scans": [
    { "scanId": "scan::3f2504e0-4f89-41d3-9a0c-0305e82c3301", "scanType": "Pickup", "courierId": "CR-1001", "location": "Sydney depot", "scannedAtUtc": "{{$datetime iso8601}}", "notes": "Fictional pickup" },
    { "scanId": "scan::3f2504e0-4f89-41d3-9a0c-0305e82c3302", "scanType": "InTransit", "courierId": "CR-1001", "location": "Sydney hub", "scannedAtUtc": "{{$datetime iso8601}}" }
  ]
}

### v1 upload scans: 400, a Delivered scan needs a signature and a scan cannot be in the future
POST {{baseUrl}}/api/v1/shipments/APX-20000001/scans
Content-Type: application/json

{
  "scans": [
    { "scanId": "scan::3f2504e0-4f89-41d3-9a0c-0305e82c3303", "scanType": "Delivered", "courierId": "CR-1001", "location": "Front door", "scannedAtUtc": "2099-01-01T00:00:00Z" }
  ]
}

### v1 scan history: 200, oldest first
GET {{baseUrl}}/api/v1/shipments/APX-20000001/scans

### v1 scan history: 404, unknown tracking number
GET {{baseUrl}}/api/v1/shipments/APX-99999999/scans

### v1 delete: 409, only a Created shipment can be deleted (this one is PickedUp now)
DELETE {{baseUrl}}/api/v1/shipments/APX-20000001

### v1 delete: 204, a seeded shipment that is still Created (APX-10000005)
DELETE {{baseUrl}}/api/v1/shipments/APX-10000005

### v1 delete: 404, unknown tracking number
DELETE {{baseUrl}}/api/v1/shipments/APX-99999999

# ===================================================================================================
# Version 2: nested recipient, latestScan and status as a name.
# ===================================================================================================

