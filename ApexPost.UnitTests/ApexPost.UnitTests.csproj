<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast tests with no database, no file system and no network. Dependencies are mocked (Moq) or faked. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Testing\ApexPost.Testing.csproj" />
    <ProjectReference Include="..\ApexPost.Domain\ApexPost.Domain.csproj" />
    <ProjectReference Include="..\ApexPost.Application\ApexPost.Application.csproj" />
    <ProjectReference Include="..\ApexPost.Infrastructure\ApexPost.Infrastructure.csproj" />
    <ProjectReference Include="..\ApexPost.Tracking\ApexPost.Tracking.csproj" />
    <ProjectReference Include="..\ApexPost.Courier.Offline\ApexPost.Courier.Offline.csproj" />
    <ProjectReference Include="..\ApexPost.Courier.Core\ApexPost.Courier.Core.csproj" />
    <ProjectReference Include="..\ApexPost.Web\ApexPost.Web.csproj" Aliases="global,web" />
    <ProjectReference Include="..\ApexPost.Api\ApexPost.Api.csproj" Aliases="global,api" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
